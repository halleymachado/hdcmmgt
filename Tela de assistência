# Função para criar balões arredondados
def balao(x1, y1, x2, y2, cor, texto, ancora, tag):

    tela.create_oval(
        x1, y1, x1+18, y2,
        fill=cor,
        outline=cor
    )

    tela.create_oval(
        x2-18, y1, x2, y2,
        fill=cor,
        outline=cor
    )

    tela.create_rectangle(
        x1+9, y1, x2-9, y2,
        fill=cor,
        outline=cor
    )

    tela.create_text(
        (x1+x2)/2,
        (y1+y2)/2,
        text=texto,
        fill=PRETO,
        font=("Arial", 8, "bold"),
        tags=tag
    )


