# Área de mensagens
mensagens = []

def enviar_mensagem(event=None):

    mensagem = entrada.get().strip()

    if mensagem == "":
        return

    # Posição da nova mensagem
    y = 215 + len(mensagens) * 42

    # Evita ultrapassar a área visível
    if y > 285:
        return

    # Mensagem do usuário
    balao(
        120, y, 199, y+22,
        "#BBBBBB",
        mensagem,
        "center",
        f"msg{len(mensagens)}"
    )

    mensagens.append(mensagem)

    entrada.delete(0, tk.END)

    # Resposta simulada
    resposta = "Como posso ajudar?"

    y_resposta = y + 27

    tela.create_text(
        23, y_resposta+10,
        text="EcoLink",
        fill="#00C853",
        font=("Arial", 6, "bold")
    )

    balao(
        39, y_resposta, 160, y_resposta+20,
        VERDE_CLARO,
        resposta,
        "center",
        f"resp{len(mensagens)}"
    )


