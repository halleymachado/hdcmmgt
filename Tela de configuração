# Função para criar botões arredondados
def botao_arredondado(y, texto, icone, comando, tag):

    x1 = 38
    x2 = 259
    altura = 39

    # Corpo do botão
    tela.create_oval(
        x1, y, x1+altura, y+altura,
        fill=VERDE,
        outline="#444444",
        width=1.5
    )

    tela.create_oval(
        x2-altura, y, x2, y+altura,
        fill=VERDE,
        outline="#444444",
        width=1.5
    )

    tela.create_rectangle(
        x1+altura/2, y,
        x2-altura/2, y+altura,
        fill=VERDE,
        outline=VERDE
    )

    # Ícone
    tela.create_text(
        64, y+19,
        text=icone,
        fill=PRETO,
        font=("Arial", 18, "bold"),
        tags=tag
    )

    # Texto
    tela.create_text(
        155, y+19,
        text=texto,
        fill=PRETO,
        font=("Arial", 9, "bold"),
        tags=tag
    )

    # Área clicável
    tela.create_rectangle(
        x1, y, x2, y+altura,
        fill="",
        outline="",
        tags=tag
    )

    tela.tag_bind(
        tag,
        "<Button-1>",
        lambda e: comando()
    )


# MODO ESCURO
def alternar_modo():

    global modo_escuro

    modo_escuro = not modo_escuro

    if modo_escuro:
        tela.itemconfig(fundo, fill="#252525")
        tela.itemconfig(texto_modo, fill="white")
        tela.itemconfig(bolinha, fill="#00C853")
        tela.itemconfig(bolinha_contorno, fill="#00C853")
    else:
        tela.itemconfig(fundo, fill=BRANCO)
        tela.itemconfig(texto_modo, fill=PRETO)
        tela.itemconfig(bolinha, fill="#666666")
        tela.itemconfig(bolinha_contorno, fill="#666666")


