# Função para coletar missão
def coletar_missao(numero, recompensa, botao):
    global exp

    exp += recompensa

    tela.itemconfig(
        exp_texto,
        text=str(exp)
    )

    tela.itemconfig(
        botao,
        text="Coletado",
        fill="#888888"
    )

    tela.tag_unbind(botao, "<Button-1>")

    messagebox.showinfo(
        "EcoLink",
        f"Missão concluída!\nVocê recebeu {recompensa} EXP."
    )


# Função para criar botão
def criar_botao(y, numero, recompensa):
    x1, x2 = 158, 207

    tela.create_oval(
        x1, y, x1+12, y+15,
        fill=VERDE,
        outline=VERDE,
        tags=f"botao{numero}"
    )

    tela.create_oval(
        x2-12, y, x2, y+15,
        fill=VERDE,
        outline=VERDE,
        tags=f"botao{numero}"
    )

    tela.create_rectangle(
        x1+6, y, x2-6, y+15,
        fill=VERDE,
        outline=VERDE,
        tags=f"botao{numero}"
    )

    texto = tela.create_text(
        (x1+x2)/2,
        y+7,
        text="Coletar",
        fill="black",
        font=("Arial", 7),
        tags=f"botao{numero}"
    )

    tela.tag_bind(
        f"botao{numero}",
        "<Button-1>",
        lambda e: coletar_missao(
            numero, recompensa, texto
        )
    )


